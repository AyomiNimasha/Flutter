# Local development only. Copy to .env, which is excluded from Git.
POSTGRES_DB=pawshots
POSTGRES_USER=pawshots
POSTGRES_PASSWORD=pawshots_local_dev_only
# Use 5433 to avoid conflicting with a host PostgreSQL installation.
POSTGRES_PORT=5433

# For the future API running directly on the host. Match the values above;
# URL-encode special characters in the username/password if you change them.
DATABASE_URL=postgresql://pawshots:pawshots_local_dev_only@localhost:5433/pawshots
# A future API container connects to db:5432 instead of localhost:5433.
